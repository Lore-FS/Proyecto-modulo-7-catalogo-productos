{
  "name": "nombre-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "productcard": "vue-cli-service test:unit tests/unit/ProductCardComponent.spec.js",
    "listaproductos": "vue-cli-service test:unit tests/unit/ListaProductosView.spec.js",
    "test:e2e:run": "cypress run",
    "test:e2e:spec": "cypress run --spec cypress/e2e/FiltroProductos.cy.js",
    "e2e": "start-server-and-test serve http://localhost:8080 test:e2e:run",
    "lint": "vue-cli-service lint",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.13.6",
    "core-js": "^3.8.3",
    "vue": "^3.2.13",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.4",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-unit-jest": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^2.0.0-0",
    "@vue/vue3-jest": "^27.0.0-alpha.1",
    "babel-jest": "^27.0.6",
    "cypress": "^15.21.1",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-vue": "^8.0.3",
    "flush-promises": "^1.0.2",
    "gh-pages": "^6.3.0",
    "jest": "^27.0.5",
    "start-server-and-test": "^3.0.12"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2021": true,
      "cypress/globals": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended",
      "plugin:cypress/recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "plugins": [
      "cypress"
    ],
    "globals": {
      "defineProps": "readonly",
      "defineEmits": "readonly",
      "defineExpose": "readonly",
      "withDefaults": "readonly"
    },
    "rules": {},
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)",
          "**/tests/unit/**/*.spec.{j,t}s?(x)"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
